<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing of OneNode is backed up or copied to a new phone. The device key lives inside the phone's Keystore
     and cannot move, so a restored list of paired devices would point at a key that no longer exists. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
